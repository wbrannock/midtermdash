{
  "name": "midtermdash",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "pipeline": "tsx pipeline/run.ts",
    "fetch-historical": "tsx scripts/fetch-historical.ts",
    "build-baselines": "tsx scripts/build-baselines.ts",
    "check-baselines": "tsx scripts/build-baselines.ts --check",
    "fetch-historical-tx": "tsx scripts/fetch-historical-tx.ts",
    "build-tx-baselines": "tsx scripts/build-tx-baselines.ts",
    "check-tx-baselines": "tsx scripts/build-tx-baselines.ts --check"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
